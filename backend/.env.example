PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Keka SSO authority supplied by Keka; production documentation uses https://login.keka.com.
# Use the exact authority Keka provides for your SSO client/workspace.
KEKA_SSO_AUTHORITY=https://login.keka.com
KEKA_SSO_CLIENT_ID=
KEKA_SSO_CLIENT_SECRET=
KEKA_SSO_REDIRECT_URI=http://localhost:3001/api/keka/callback
# Generate 32 random bytes and encode as 64 hexadecimal characters. Keep this secret private.
KEKA_SESSION_SECRET=
SESSION_COOKIE_NAME=rt_keka_session
